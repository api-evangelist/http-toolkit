  "info": {
    "_postman_id": "b4b36f69-8585-44ee-b59c-b67650efc882",
    "name": "HTTP Toolkit Server client interceptors API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The backend REST API exposed by the HTTP Toolkit server, used to start and manage the local HTTP/HTTPS proxy, launch intercepted applications, manage interception rules, handle certificate operations, and send requests through the proxy. The server listens on localhost (default port 45456) and uses token-based authentication via the Authorization header.\n\n\nContact Support:\n Name: HTTP Toolkit",
      "type": "text/plain"
    }
  }
