        {
          "id": "23ecc640-49c3-4a3c-8ad1-ea5e7336e27b",
          "name": "Activate an interceptor",
          "request": {
            "name": "Activate an interceptor",
            "description": {
              "content": "Activates a specific interceptor for the given proxy port, injecting the proxy configuration into the target application or environment. The result may include success:false for non-critical failures (e.g., Chrome prompt-to-quit scenarios) without throwing an error.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "interceptors",
                ":id",
                "activate",
                ":proxyPort"
              ],
